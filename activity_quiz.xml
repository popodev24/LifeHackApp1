<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1C0A00"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/questionNumber"
        android:textColor="#9A8A7A"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/questionText"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#F5E6C8"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/hackButton"
        android:text="Hack — True"
        android:textColor="#1C0A00"
        android:backgroundTint="#C47B2B"
        android:layout_marginBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/mythButton"
        android:text="Myth — False"
        android:textColor="#F5E6C8"
        android:backgroundTint="#3B1A08"
        android:layout_marginBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/feedbackText"
        android:textSize="15sp"
        android:textColor="#C47B2B"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/nextButton"
        android:text="Next"
        android:textColor="#F5E6C8"
        android:backgroundTint="#3B1A08"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>